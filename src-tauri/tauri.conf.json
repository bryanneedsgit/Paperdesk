{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Paperdesk",
  "version": "0.1.1",
  "identifier": "com.paperdesk.app",
  "build": {
    "beforeDevCommand": "npm run dev:vite -- --host 127.0.0.1 --port 5175",
    "beforeBuildCommand": "npm run build:vite",
    "devUrl": "http://127.0.0.1:5175",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Paperdesk",
        "label": "main",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 620,
        "resizable": true,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection,msTouchpadPinchSmoothZooming"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' asset:",
        "connect-src": "'self' asset: ipc: http://ipc.localhost",
        "img-src": "'self' asset: http://asset.localhost blob: data:",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'",
        "worker-src": "'self' blob:"
      },
      "devCsp": {
        "default-src": "'self' asset: http://127.0.0.1:5175",
        "connect-src": "'self' asset: ipc: http://ipc.localhost http://127.0.0.1:5175 ws://127.0.0.1:5175",
        "img-src": "'self' asset: http://asset.localhost http://127.0.0.1:5175 blob: data:",
        "script-src": "'self' 'wasm-unsafe-eval' http://127.0.0.1:5175",
        "style-src": "'self' 'unsafe-inline' http://127.0.0.1:5175",
        "worker-src": "'self' blob: http://127.0.0.1:5175"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Offline desktop PDF workspace",
    "longDescription": "Paperdesk is an offline-first desktop PDF reader and editor for page-level workflows.",
    "fileAssociations": [
      {
        "ext": ["pdf"],
        "name": "PDF Document",
        "description": "Portable Document Format",
        "mimeType": "application/pdf",
        "role": "Viewer",
        "rank": "Owner",
        "contentTypes": ["com.adobe.pdf"]
      }
    ],
    "icon": [
      "icons/icon.png",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
